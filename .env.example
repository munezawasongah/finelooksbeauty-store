# ---- Required --------------------------------------------------------------
# Railway: set to the Postgres service reference ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Railway: ${{Redis.REDIS_URL}}  (needed by the worker; the website falls back without it)
REDIS_URL=
# Public address of the website, no trailing slash (e.g. https://finelooksbeautystore.com)
APP_URL=
# 32+ random characters. Encrypts MFA secrets and Clover tokens. Never change it after launch.
# PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
APP_ENCRYPTION_KEY=
# web (default) or worker — the worker service sets SERVICE_ROLE=worker
SERVICE_ROLE=web

# ---- First owner account ----------------------------------------------------
# Visit /admin/setup?token=<SETUP_TOKEN> once to create the owner, then delete this variable.
SETUP_TOKEN=

# ---- Stripe (U.S. account, USD) --------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true = Stripe Tax calculates sales tax by address (enable Stripe Tax + NC registration first)
STRIPE_AUTOMATIC_TAX=true

# ---- Clover (North America) ------------------------------------------------
CLOVER_ENVIRONMENT=sandbox
CLOVER_APP_ID=
CLOVER_APP_SECRET=
# Shown in the Clover developer dashboard after the webhook URL is verified
CLOVER_WEBHOOK_AUTH_CODE=

# ---- Product image storage (S3-compatible, e.g. Railway Bucket) -----------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for the bucket. Leave empty to serve images through /media.
S3_PUBLIC_URL=

# ---- Email (any SMTP provider) ----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Fine Looks Hair & Beauty <orders@finelooksbeautystore.com>
# Extra address for security and integration alerts (owners/managers always get them)
ALERT_EMAIL=
